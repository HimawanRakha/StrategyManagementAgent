# Salin menjadi .env.local lalu isi. JANGAN beri awalan NEXT_PUBLIC_ pada key apa pun.

# ===== Database =====
# Neon (produksi):  postgresql://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
# Kosongkan atau pakai "pglite:./.data/pglite" untuk Postgres tertanam lokal (tanpa server).
DATABASE_URL=pglite:./.data/pglite

# ===== LLM =====
LLM_PROVIDER=auto                   # auto = Gemini bila GEMINI_API_KEY terisi, kalau kosong mode uji (mock). Bisa dipaksa: gemini | groq | mock
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=                          # kosong = gemini-flash-latest (Flash stabil terbaru). Untuk eksperimen TA, patok versi: jalankan npm run llm:check
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768                   # samakan dengan kolom vector(...) sebelum migrasi pertama
LLM_TEMPERATURE=0.2
MAX_REPAIR_ATTEMPTS=2
LLM_MIN_INTERVAL_MS=3000               # jeda antar-panggilan (ms) agar tidak kena batas paket gratis; 0 bila paket berbayar

# ===== Akses (satu kata sandi bersama untuk seluruh tim) =====
APP_PASSWORD=                       # kosong = tanpa login (hanya untuk lokal). WAJIB diisi bila di-deploy online.
AUTH_SECRET=                        # string acak panjang untuk menandatangani cookie sesi

# ===== Antrean mode otomatis (fase 2) =====
# Tanpa QSTASH_TOKEN, job dijalankan di proses server yang sama (cukup untuk lokal).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
APP_URL=http://localhost:3000
